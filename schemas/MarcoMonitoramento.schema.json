{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gaema-sd/MarcoMonitoramento.schema.json",
  "title": "MarcoMonitoramento",
  "description": "MarcoMonitoramento(*, id: 'str' = <factory>, versao: 'int' = 1, criado_em: 'datetime' = <factory>, criado_por: 'str' = '', atualizado_em: 'Optional[datetime]' = None, sintetico: 'bool' = False, plano_id: 'str', descricao: 'str', indicador: 'str' = '', data_prevista: 'date', data_verificada: 'Optional[date]' = None, situacao: 'SituacaoMarco' = <SituacaoMarco.PREVISTO: 'PREVISTO'>, campanha_verificacao_id: 'Optional[str]' = None)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "versao": {
      "type": "integer"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    },
    "criado_por": {
      "type": "string"
    },
    "atualizado_em": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "sintetico": {
      "type": "boolean"
    },
    "plano_id": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "indicador": {
      "type": "string"
    },
    "data_prevista": {
      "type": "string",
      "format": "date"
    },
    "data_verificada": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "situacao": {
      "type": "string",
      "enum": [
        "PREVISTO",
        "VERIFICACAO_PENDENTE",
        "CUMPRIDO",
        "NAO_CUMPRIDO",
        "CANCELADO"
      ]
    },
    "campanha_verificacao_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "plano_id",
    "descricao",
    "data_prevista"
  ],
  "additionalProperties": false
}
