{
  "name": "GAEMA SD (protótipo de teste, dados sintéticos)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements-dev.txt",
  "postAttachCommand": "scripts/interface.sh",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "GAEMA SD — interface (dados sintéticos)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
