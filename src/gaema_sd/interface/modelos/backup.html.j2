{% extends "base.html.j2" %}
{% block titulo %}Backup{% endblock %}
{% block conteudo %}
<h1>Backup</h1>
<p>O backup é verificado ao ser criado (arquivos conferidos contra o banco e a trilha). Ele fica neste computador; <strong>guarde uma cópia fora dele</strong> (a política de guarda e retenção ainda é pendência institucional).</p>
<form method="post" action="/backup/criar">
  <input type="hidden" name="csrf" value="{{ sessao.csrf }}">
  <button type="submit">Criar backup agora</button>
</form>
{% if backups %}
<table>
  <caption>Backups neste computador</caption>
  <thead><tr><th scope="col">Backup</th><th scope="col">Conferir</th></tr></thead>
  <tbody>{% for b in backups %}
    <tr><th scope="row">{{ b }}</th><td><form method="post" action="/backup/verificar" class="linha">
      <input type="hidden" name="csrf" value="{{ sessao.csrf }}"><input type="hidden" name="nome" value="{{ b }}">
      <button type="submit" class="secundario">Verificar {{ b }}</button></form></td></tr>
  {% endfor %}</tbody>
</table>
{% else %}<p>Nenhum backup ainda.</p>{% endif %}
{% endblock %}
