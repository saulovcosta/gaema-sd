{% extends "base.html.j2" %}
{% block titulo %}Auditoria{% endblock %}
{% block conteudo %}
<h1>Trilha de auditoria</h1>
<p>{{ total }} eventos registrados. Cada evento guarda o código do anterior: alterar ou apagar um evento quebra a cadeia.</p>
<form method="post" action="/auditoria/verificar">
  <input type="hidden" name="csrf" value="{{ sessao.csrf }}">
  <label for="ancora_arquivo">Arquivo de âncora guardado fora do computador (opcional; caminho)</label>
  <input type="text" id="ancora_arquivo" name="ancora_arquivo">
  <button type="submit">Verificar a trilha</button>
</form>
<form method="post" action="/auditoria/ancora">
  <input type="hidden" name="csrf" value="{{ sessao.csrf }}">
  <button type="submit" class="secundario">Gerar âncora para guardar fora do computador</button>
</form>
<p class="discreto">A âncora só protege se for guardada por quem não controla o banco (pen drive, outro sistema). Isso é decisão institucional (R-19).</p>
<table>
  <caption>Últimos eventos</caption>
  <thead><tr><th scope="col">Nº</th><th scope="col">Quando</th><th scope="col">Ação</th><th scope="col">Usuário</th><th scope="col">Entidade</th><th scope="col">Motivo</th></tr></thead>
  <tbody>{% for e in eventos %}
    <tr><td>{{ e.sequencia }}</td><td>{{ e.ocorrido_em.isoformat() }}</td><td>{{ e.acao }}</td><td>{{ e.ator_id }}</td><td>{{ e.entidade }}</td><td>{{ e.motivo or "—" }}</td></tr>
  {% endfor %}</tbody>
</table>
{% endblock %}
