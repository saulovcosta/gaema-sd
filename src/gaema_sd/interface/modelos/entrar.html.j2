{% extends "base.html.j2" %}
{% block titulo %}Entrar{% endblock %}
{% block conteudo %}
<h1>Entrar (usuário de teste)</h1>
<div class="proxima"><p class="rotulo">O que fazer agora</p><p class="frase">Toque no papel com que quer operar.</p>
  <p class="discreto">Não há senha nem autenticação real: escolhe-se um usuário de teste. Este é um protótipo com dados inventados.</p></div>
<h2>Papéis de teste</h2>
<ul class="papeis">
{% for chave, papel, ident, pode in usuarios %}
  <li class="cartao"><form method="post" action="/entrar">
    <input type="hidden" name="csrf" value="{{ sessao.csrf }}"><input type="hidden" name="usuario" value="{{ chave }}">
    <button type="submit">Entrar como {{ papel }}</button>
    <p class="pode">Pode: {{ pode }}{{ "" if pode.endswith("…") else "." }} <span class="discreto">Usuário: {{ ident }}</span></p>
  </form></li>
{% endfor %}
</ul>
{% endblock %}
