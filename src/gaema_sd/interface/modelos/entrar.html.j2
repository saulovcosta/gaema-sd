{% extends "base.html.j2" %}
{% block titulo %}Entrar{% endblock %}
{% block conteudo %}
<h1>Entrar (usuário de teste)</h1>
<p>Não há senha: este é um protótipo com dados inventados. Escolha com qual papel quer operar.</p>
<form method="post" action="/entrar">
  <input type="hidden" name="csrf" value="{{ sessao.csrf }}">
  <label for="usuario">Usuário de teste</label>
  <select id="usuario" name="usuario" required>
    {% for chave, papel, ident in usuarios %}<option value="{{ chave }}">{{ papel }} — {{ ident }}</option>{% endfor %}
  </select>
  <button type="submit">Entrar</button>
</form>
{% endblock %}
