{% extends "base.html.j2" %}
{% block titulo %}Entrar{% endblock %}
{% block conteudo %}
<h1>Entrar (usuário de teste)</h1>
<p class="proxima"><span class="rotulo">O que fazer agora</span><span class="frase">Escolha com qual papel quer operar e toque em Entrar.</span>
  Não há senha: este é um protótipo com dados inventados.</p>
<form method="post" action="/entrar" class="cartao">
  <input type="hidden" name="csrf" value="{{ sessao.csrf }}">
  <fieldset>
    <legend>Usuário de teste</legend>
    <ul class="lista">
    {% for chave, papel, ident, pode in usuarios %}
      <li><label for="u-{{ chave }}" class="opcoes"><input type="radio" id="u-{{ chave }}" name="usuario" value="{{ chave }}"{% if loop.first %} checked{% endif %}>
          <span><strong>{{ papel }}</strong> <span class="discreto">({{ ident }})</span><br><span class="discreto">Pode: {{ pode }}.</span></span></label></li>
    {% endfor %}
    </ul>
  </fieldset>
  <div class="acoes"><button type="submit">Entrar</button></div>
</form>
{% endblock %}
