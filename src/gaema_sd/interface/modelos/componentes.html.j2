{% macro icone(nome) -%}<svg class="icone" aria-hidden="true" focusable="false"><use href="#i-{{ nome }}"/></svg>{%- endmacro %}

{% macro etiqueta(estado) -%}
{%- set s = L.situacao(estado) -%}
<span class="etiqueta tom-{{ s.tom }}">{{ icone(s.tom) }}<span>{{ s.nome }}</span></span>
{%- endmacro %}

{% macro bloqueado(texto, razao, ident) -%}
<button type="button" disabled aria-describedby="razao-{{ ident }}">{{ icone("cadeado") }}{{ texto }}</button>
<p class="razao" id="razao-{{ ident }}">{{ icone("cadeado") }}<span>Por que não: {{ razao }}</span></p>
{%- endmacro %}
