{% extends "base.html.j2" %}
{% block titulo %}Painel{% endblock %}
{% block conteudo %}
<h1>Painel</h1>
{% if sem_acesso %}<p class="aviso-erro" role="alert">Seu papel não lê demandas: {{ sem_acesso }}</p>{% endif %}
{% if conflitos is not none %}
<p>Conflitos de sincronização abertos: <strong>{{ conflitos }}</strong>{% if conflitos %} — <a href="/conflitos">ver</a>{% endif %}.</p>
{% endif %}
{% if demandas %}
<table>
  <caption>Demandas</caption>
  <thead><tr><th scope="col">Demanda</th><th scope="col">Situação</th><th scope="col">Prioridade (registro humano)</th><th scope="col">Pontos</th><th scope="col">Relatórios</th></tr></thead>
  <tbody>
  {% for d in demandas %}
    <tr>
      <th scope="row"><a href="/demanda/{{ d.demanda_id }}">{{ d.titulo or d.demanda_id }}</a><br><span class="hash discreto">{{ d.demanda_id }}</span></th>
      <td>{{ d.estado }}<br><span class="discreto">{{ descricao_estado(d.estado) }}</span></td>
      <td>{{ d.criterio_priorizacao or "não registrada" }}</td>
      <td>{{ d.pontos }}</td>
      <td>{{ d.relatorios|length }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% elif not sem_acesso %}
<p>Nenhuma demanda cadastrada neste banco.</p>
{% endif %}
{% endblock %}
