{% extends "base.html.j2" %}
{% block titulo %}Conflito{% endblock %}
{% block conteudo %}
<h1>Conflito: {{ tipo_leigo }}</h1>
<div class="proxima"><p class="rotulo">O que fazer agora</p>
  <p class="frase">{% if k.situacao == "ABERTO" %}Compare as duas versões e decida qual vale.{% else %}Nada: este conflito já foi decidido ({{ decisao_leiga }}).{% endif %}</p>
  {% if k.situacao == "ABERTO" %}<p class="discreto">Depois de decidir, mova a demanda de volta na página dela: o sistema não faz isso sozinho. O aparelho recebe a decisão na próxima sincronização.</p>{% endif %}</div>
<dl class="dados">
  <dt>Versão que o aparelho conhecia</dt><dd>{{ k.versao_base }}</dd>
  <dt>Versão da central quando o conflito abriu</dt><dd>{{ k.versao_central }}</dd>
  <dt>Versão atual da central</dt><dd>{{ k.versao_atual_central if k.versao_atual_central is not none else "—" }}</dd>
  <dt>Registro</dt><dd class="hash">{{ k.entidade_id }}</dd>
</dl>
{% if k.campos %}
<table class="tabela">
  <caption>O que difere entre as duas versões</caption>
  <thead><tr><th scope="col">Informação</th><th scope="col">Versão da central</th><th scope="col">Versão do aparelho</th></tr></thead>
  <tbody>{% for f in k.campos %}<tr><th scope="row">{{ L.nome_campo(f.campo) }}</th><td data-rotulo="Central">{{ f.central }}</td><td data-rotulo="Aparelho">{{ f.aparelho }}</td></tr>{% endfor %}</tbody>
</table>
{% else %}<p>Não há diferença de conteúdo nas informações exibidas.</p>{% endif %}
{% if k.situacao == "ABERTO" %}
<form method="post" action="/conflitos/{{ k.id }}/resolver" class="cartao">
  <input type="hidden" name="csrf" value="{{ sessao.csrf }}">
  <fieldset><legend>Sua decisão</legend>
    <div class="opcoes">
      <label for="d-central"><input type="radio" id="d-central" name="decisao" value="MANTER_CENTRAL" checked> Manter a versão da central (a do aparelho fica guardada)</label>
      {% if k.aceitar_possivel %}<label for="d-aparelho"><input type="radio" id="d-aparelho" name="decisao" value="ACEITAR_DISPOSITIVO"> Aceitar a versão do aparelho (vira a versão corrente)</label>{% endif %}
    </div>
    {% if not k.aceitar_possivel %}<p class="razao">{{ c.icone("cadeado") }}<span>“Aceitar a versão do aparelho” não está disponível: o registro mudou na central depois do conflito, ou é uma foto/documento (não se altera), ou tem outro identificador.</span></p>{% endif %}
  </fieldset>
  <label for="motivo">Motivo da decisão</label>
  <span class="ajuda-campo" id="ajuda-motivo">Pelo menos 10 letras. Não escreva dados pessoais.</span>
  <input type="text" id="motivo" name="motivo" required minlength="10" aria-describedby="ajuda-motivo">
  <div class="acoes"><button type="submit">Registrar decisão</button><a class="botao secundario" href="/conflitos">Voltar à lista</a></div>
</form>
{% else %}<p><a class="botao secundario" href="/conflitos">Voltar à lista</a></p>{% endif %}
{% endblock %}
